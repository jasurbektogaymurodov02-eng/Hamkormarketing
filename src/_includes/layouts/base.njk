<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}{% if title != site.nom %} — {{ site.qisqa }}{% endif %}</title>
<meta name="description" content="{{ description or site.tavsif }}">
<link rel="icon" href="/assets/favicon.ico" sizes="any">
<link rel="icon" href="/assets/favicon.png" type="image/png">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description or site.tavsif }}">
<meta property="og:type" content="website">
<meta property="og:image" content="{{ site.domen }}/assets/og.png">
<meta property="og:locale" content="uz_UZ">
<meta property="og:site_name" content="{{ site.nom }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description or site.tavsif }}">
<meta name="twitter:image" content="{{ site.domen }}/assets/og.png">
<link rel="canonical" href="{{ site.domen }}{{ page.url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500&family=Saira:wght@600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/anim.css">
<script>document.documentElement.classList.add('js','is-loading');</script>
</head>
<body>
<a class="skip" href="#main">Asosiy qismga o'tish</a>

<div class="curtain" aria-hidden="true">
  <img src="/assets/logo-cream.png" alt="">
  <span class="curtain__pct">0%</span>
</div>
<div class="scroll-bar" aria-hidden="true"></div>

{% include "partials/header.njk" %}

<main id="main">
{{ content | safe }}

{% if ctaYashir != true %}{% include "partials/cta.njk" %}{% endif %}
</main>

{% include "partials/footer.njk" %}

<script src="/js/main.js" defer></script>
<script src="/js/anim.js" defer></script>
<!-- Netlify Identity: /admin ga kirish va taklifnoma havolalari uchun -->
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", function (user) {
      if (!user) {
        window.netlifyIdentity.on("login", function () { document.location.href = "/admin/"; });
      }
    });
  }
</script>
</body>
</html>
